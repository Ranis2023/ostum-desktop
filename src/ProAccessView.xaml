<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F5F1">
  <Grid.Resources><!--theme--></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <Border CornerRadius="18" Padding="20,15" Background="#27332D" Margin="0,0,0,8"><StackPanel>
      <TextBlock Text="Бессрочный OSTUM Pro" FontSize="25" FontWeight="SemiBold" Foreground="White"/>
      <TextBlock Text="Рабочие папки, Word, Excel и обучение на своих данных." Foreground="#DBE8DA" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <Border x:Name="Granted" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Pro активирован" Style="{StaticResource Title}"/><TextBlock Text="Доступ закреплён за этим компьютером и профилем Windows. Для новой установки получите отдельный файл у того же бота." Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel></Border>
    <StackPanel x:Name="Steps">
      <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel>
        <TextBlock Text="1. Откройте бота на телефоне" Style="{StaticResource Subhead}"/>
        <WrapPanel Margin="0,5,0,0"><Image x:Name="Qr" Width="164" Height="164" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR для активации этого компьютера"/>
          <StackPanel Width="238" Margin="6,5,0,0"><TextBlock x:Name="NetHint" Text="Наведите камеру на QR и нажмите «Запустить». При первой проверке подпишитесь на канал Раниса Галиаскарова. Интернет нужен на телефоне." Style="{StaticResource Hint}"/><Button x:Name="Verify" Tag="external" ContentTemplate="{DynamicResource OstumLabel}" Content="Открыть бота на этом ПК" HorizontalAlignment="Left" Margin="0,6,0,0"/><Button x:Name="Channel" Tag="external" ContentTemplate="{DynamicResource OstumLabel}" Content="Открыть канал" Style="{StaticResource Flat}" HorizontalAlignment="Left"/></StackPanel>
        </WrapPanel>
        <Expander Header="Передать код без камеры" Margin="0,4"><StackPanel><TextBlock Text="Отправьте этот код в личный чат @rangoostum_bot с любого устройства с Telegram." Style="{StaticResource Hint}"/><TextBox x:Name="Request" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Код установки"/><WrapPanel><Button x:Name="Copy" Tag="copy" ContentTemplate="{DynamicResource OstumLabel}" Content="Скопировать код"/><Button x:Name="SaveQR" Tag="qr" ContentTemplate="{DynamicResource OstumLabel}" Content="Сохранить QR на флешку"/></WrapPanel></StackPanel></Expander>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="2. Перенесите файл на флешке" Style="{StaticResource Subhead}"/><TextBlock Text="Сохраните OSTUM-Pro.ostumpro из ответа бота и перенесите его на этот ПК." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Background="#FFF3E5" BorderBrush="#EBC49F"><StackPanel><TextBlock Text="3. Перетащите файл сюда" Style="{StaticResource Subhead}"/><TextBlock Text="OSTUM проверит подпись локально и откроет Pro бессрочно. Файл можно также выбрать кнопкой." Style="{StaticResource Hint}" Margin="0,4"/><Button x:Name="Import" Tag="file" ContentTemplate="{DynamicResource OstumLabel}" Content="Выбрать файл .ostumpro" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="1" Margin="18,4,12,9"><Button x:Name="CloseGate" Tag="back" ContentTemplate="{DynamicResource OstumLabel}" Content="Вернуться в чат" Style="{StaticResource Flat}" DockPanel.Dock="Right" IsCancel="True"/><Button x:Name="Guide" Tag="help" ContentTemplate="{DynamicResource OstumLabel}" Content="Справка" Style="{StaticResource Flat}" DockPanel.Dock="Left"/><TextBlock x:Name="Feedback" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
</Grid>
