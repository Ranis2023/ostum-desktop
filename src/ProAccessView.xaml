<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F5F1">
  <Grid.Resources><!--theme--></Grid.Resources><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="19,18,19,0">
    <Border CornerRadius="19" Padding="20,16" Background="#27332D" Margin="0,0,0,9"><DockPanel><Border DockPanel.Dock="Left" Background="#FF914F" Width="44" Height="44" CornerRadius="13" Margin="0,0,13,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="20" Foreground="#332418"/></Border><StackPanel><TextBlock Text="Доступ к OSTUM Pro" FontSize="25" FontWeight="SemiBold" Foreground="#FFFDF7"/><TextBlock Text="Рабочие папки, редакторы Word и Excel и обучение Zarum для подписчиков канала." Foreground="#DCE5D9" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="1. Подпишитесь на канал" Style="{StaticResource Subhead}"/><TextBlock Text="Откройте канал Раниса Галиаскарова в Telegram и нажмите «Подписаться»." Style="{StaticResource Hint}" Margin="0,4,0,5"/><Button x:Name="Channel" Content="Открыть @ranisgaliaskarov" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="2. Получите файл у бота" Style="{StaticResource Subhead}"/><TextBlock x:Name="NetHint" Text="Нажмите «Запустить» у @rangoostum_bot. Бот проверит подписку и пришлёт файл для этого ПК. Из OSTUM передаётся только код установки." Style="{StaticResource Hint}" Margin="0,4,0,5"/><Button x:Name="Verify" Content="Проверить подписку в Telegram" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><DockPanel Margin="0,5,0,0"><Button x:Name="Copy" Content="Скопировать код" DockPanel.Dock="Right" Style="{StaticResource Flat}" Margin="6,0,0,0"/><TextBox x:Name="Request" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Код запроса для бота" ToolTip="Этот код можно передать боту с другого устройства"/></DockPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}" Background="#FFF9F2" BorderBrush="#EDC7A9"><StackPanel><TextBlock Text="3. Перетащите файл сюда" Style="{StaticResource Subhead}"/><TextBlock Text="Подойдёт файл .ostumpro из ответа бота. После активации Pro доступен семь дней без интернета. Для продления повторите проверку." Style="{StaticResource Hint}" Margin="0,4,0,5"/><Button x:Name="Import" Content="Выбрать файл подтверждения" HorizontalAlignment="Left"/></StackPanel></Border>
  </StackPanel></ScrollViewer><DockPanel Grid.Row="1" Margin="20,7,16,9"><Button x:Name="CloseGate" Content="Вернуться в чат" Style="{StaticResource Flat}" DockPanel.Dock="Right" IsCancel="True"/><TextBlock x:Name="Feedback" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
</Grid>
