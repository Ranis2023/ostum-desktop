<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ostum Desktop" Width="1150" Height="770" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI" FontSize="14" Background="#F8F8FC" Foreground="#292D33" UseLayoutRounding="True" AllowDrop="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F0EEF7"/><Setter Property="Foreground" Value="#3B354B"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="box" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Opacity" Value="0.83"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Opacity" Value="0.68"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#8B78CE"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#37364B"/><Setter Property="Foreground" Value="#FAF9FF"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="13,10"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#D6D2E4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="row" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}" FontSize="13" ToolTip="{Binding Title}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#322F45"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#454058"/><Setter Property="Foreground" Value="White"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Layout">
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#242333">
      <Grid Margin="16,24,16,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,0,0,24"><Button x:Name="CollapseSidebar" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="Свернуть историю" ToolTip="Свернуть историю" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6" Background="Transparent" Foreground="#CFC8E6"/><Button x:Name="AboutApp" HorizontalAlignment="Left" Padding="0" Background="Transparent" ToolTip="О программе и обновлениях" AutomationProperties.Name="О программе и обновлениях"><StackPanel Orientation="Horizontal">
          <Image x:Name="SidebarMark" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="OSTUM" FontSize="20" FontWeight="Bold" Foreground="#FFF8EF"/><TextBlock x:Name="AppVersion" FontSize="10" Foreground="#D7C7C2"/></StackPanel>
        </StackPanel></Button></Grid>
        <Button x:Name="NewChat" Grid.Row="1" Style="{StaticResource SidebarAction}" Background="#DDD5FF" Foreground="#322450" AutomationProperties.Name="Новый чат">
          <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="18" LineHeight="18" Margin="0,-2,9,0"/><TextBlock Text="Новый чат" FontWeight="SemiBold"/></StackPanel>
        </Button>
        <DockPanel Grid.Row="2" Margin="5,18,0,6">
          <Button x:Name="ArchiveSwitch" DockPanel.Dock="Right" Padding="5,3" Background="Transparent" Foreground="#D7C8B9" FontSize="11" AutomationProperties.Name="Переключить архив"/>
          <TextBlock x:Name="HistoryHeading" Text="История" VerticalAlignment="Center" FontSize="12" Foreground="#B9B5CA"/>
        </DockPanel>
        <ListBox x:Name="HistoryList" Grid.Row="3" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Grid.Row="4"><Button x:Name="Projects" Content="Рабочие пространства" Style="{StaticResource SidebarAction}" Margin="0,8,0,0" Background="#494059" Foreground="White"/>
        <Button x:Name="Models" Style="{StaticResource SidebarAction}" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,1,9,0"/><TextBlock Text="Модели и настройки"/></StackPanel>
        </Button></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="#E5E3EC" BorderThickness="0,0,0,1">
        <Grid Margin="28,0,24,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DockPanel LastChildFill="True"><Button x:Name="ChatActions" DockPanel.Dock="Right" Content="⋯" FontSize="18" Padding="6,1" VerticalAlignment="Center" ToolTip="Действия с диалогом" AutomationProperties.Name="Действия с диалогом"/><Button x:Name="ExpandSidebar" Visibility="Collapsed" DockPanel.Dock="Left" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="Открыть историю" ToolTip="Открыть историю"/><TextBlock x:Name="ChatTitle" Text="Новый чат" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/></DockPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="ModelLight" Width="7" Height="7" Fill="#4D856B" Margin="0,0,7,0"/>
            <TextBlock x:Name="ModelLabel" FontSize="12" Foreground="#5A5566"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Transcript" MaxWidth="820" Margin="28,16,28,12"/>
        </ScrollViewer>
        <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
          <Image x:Name="WelcomeMark" Width="84" Height="84" Margin="0,0,0,13" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Что сделаем сегодня?" HorizontalAlignment="Center" FontSize="35" FontWeight="SemiBold" Foreground="#302A41" Margin="0,0,0,18"/>
          <WrapPanel HorizontalAlignment="Center">
            <Button x:Name="QuickPhoto" Margin="4" Padding="15,11" Background="White" BorderBrush="#DFDCE9" ToolTip="Приложить фото для анализа"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" Foreground="#79649C" Margin="0,1,8,0"/><TextBlock Text="Разобрать фото"/></StackPanel></Button>
            <Button x:Name="QuickAgents" Margin="4" Padding="15,11" Background="White" BorderBrush="#DFDCE9" ToolTip="Поручить задачу команде агентов"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#79649C" Margin="0,1,8,0"/><TextBlock Text="Исследовать тему"/></StackPanel></Button>
            <Button x:Name="QuickArt" Margin="4" Padding="15,11" Background="White" BorderBrush="#DFDCE9" ToolTip="Создать изображение по описанию"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" Foreground="#79649C" Margin="0,1,8,0"/><TextBlock Text="Нарисовать"/></StackPanel></Button>
          </WrapPanel>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" MaxWidth="880" Margin="24,0,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Border x:Name="RunPanel" Visibility="Collapsed" Background="#F0EDF9" CornerRadius="10" BorderThickness="1" BorderBrush="#E4DFF2" Padding="10,6" Margin="0,4,0,2"><DockPanel><Ellipse DockPanel.Dock="Left" x:Name="RunDot" Width="7" Height="7" Fill="#7859CB" Margin="1,0,9,0"/><WrapPanel x:Name="StageList"/></DockPanel></Border>
        <TextBlock x:Name="Activity" MinHeight="18" FontSize="12" Foreground="#675E77" TextWrapping="Wrap" Margin="4,2,3,5"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9D5E4" BorderThickness="1" CornerRadius="13" Padding="14,9,10,9">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="AttachmentBar" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
              <Image x:Name="AttachPreview" Width="32" Height="32" Stretch="Uniform"/>
              <TextBlock x:Name="DocIcon" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Visibility="Collapsed"/>
              <TextBlock x:Name="AttachName" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="7,0"/>
              <Button x:Name="RemoveAttach" Content="×" Padding="6,1" ToolTip="Убрать вложение" AutomationProperties.Name="Убрать вложение"/>
            </StackPanel>
            <Border x:Name="MicStrip" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="9,5" Background="#F8F2F5" Margin="0,0,0,7">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="#A74461" Margin="0,0,7,0"/>
                <TextBlock x:Name="MicInputName" Grid.Column="1" FontSize="12" Foreground="#614756" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#E6D6DE" Width="74" Height="4" CornerRadius="2" Margin="10,0" VerticalAlignment="Center">
                  <Border x:Name="MicLevel" HorizontalAlignment="Left" Width="0" Background="#9F5271" CornerRadius="2"/>
                </Border>
                <TextBlock x:Name="MicTime" Grid.Column="3" FontSize="12" Text="0:00" Foreground="#710F3B" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="2,2,2,8">
              <TextBox x:Name="Input" AutomationProperties.Name="Сообщение" MinHeight="46" MaxHeight="130" FontSize="15" FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
                  Foreground="#302B3A" CaretBrush="#6B52BC" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="0"/>
              <TextBlock x:Name="Placeholder" Text="Напишите сообщение…" Foreground="#716C7D" FontSize="15" IsHitTestVisible="False"/>
            </Grid>
            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="Attach" FontFamily="Segoe MDL2 Assets" Content="&#xE723;" FontSize="16" ToolTip="Прикрепить фото или документ" AutomationProperties.Name="Прикрепить файл" Padding="8,7" Margin="0,0,6,0"/>
                <Button x:Name="Microphone" FontFamily="Segoe MDL2 Assets" Content="&#xE720;" FontSize="15" AutomationProperties.Name="Микрофон" ToolTip="Записать голосовое сообщение" Padding="8,7" Margin="0,0,1,0"/>
                <Button x:Name="MicDevices" FontFamily="Segoe MDL2 Assets" Content="&#xE70D;" FontSize="10" AutomationProperties.Name="Выбрать микрофон" ToolTip="Выбрать микрофон" Padding="4,9" Margin="0,0,5,0"/>
                <Button x:Name="Toolbox" FontFamily="Segoe MDL2 Assets" Content="&#xE712;" FontSize="16" AutomationProperties.Name="Инструменты" ToolTip="Экран, окна, голос и рабочий профиль" Padding="8,7" Margin="0,0,8,0"/>
                <Button x:Name="ChatMode" Content="Авто" ToolTip="Автоматический выбор инструментов" Padding="9,6" Margin="0,0,3,0"/>
                <Button Visibility="Collapsed" x:Name="AgentMode" Content="Агенты" Padding="9,6" Margin="0,0,3,0" ToolTip="Планирование, инструменты и проверка ответа"/>
                <Button Visibility="Collapsed" x:Name="ArtMode" Content="Рисование" Padding="9,6"/>
                <CheckBox x:Name="WebSearch" Content="Веб-доступ" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" ToolTip="Разрешить оркестратору обращаться к интернету, когда для ответа нужны свежие сведения"/>
              </StackPanel>
              <Button x:Name="Send" Grid.Column="2" Background="#5944A9" Foreground="White" Content="Отправить" FontWeight="SemiBold" Padding="14,7" ToolTip="Enter — отправить, Shift+Enter — новая строка"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
