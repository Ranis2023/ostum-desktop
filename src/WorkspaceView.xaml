<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F5F1">
  <Grid.Resources><!--theme--></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="22,16,18,13">
    <Button x:Name="Help" DockPanel.Dock="Right" Content="Как работать" Style="{StaticResource Flat}" VerticalAlignment="Center" ToolTip="Короткая инструкция по работе с папкой, документами и локальным ИИ"/>
    <Button x:Name="ToggleFiles" DockPanel.Dock="Right" Content="Папки и файлы" Visibility="Collapsed" VerticalAlignment="Center"/>
    <Border DockPanel.Dock="Left" Width="45" Height="45" Background="#FF833E" CornerRadius="15" VerticalAlignment="Center" Margin="0,0,13,0"><Path Width="25" Height="20" Stretch="Uniform" Stroke="#422512" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M2,5 Q2,3 4,3 L10,3 13,6 22,6 Q24,6 24,8 L24,18 Q24,20 22,20 L4,20 Q2,20 2,18 Z M3,9 L23,9"/></Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Рабочее пространство" Style="{StaticResource Title}"/><TextBlock x:Name="HeadHint" Style="{StaticResource Hint}"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="16,0,16,0" x:Name="Body">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="255"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="Shade" Grid.ColumnSpan="2" Panel.ZIndex="2" Background="#55414C45" CornerRadius="18" Visibility="Collapsed"/>
    <Border x:Name="Sidebar" Style="{StaticResource Card}" Padding="13" Margin="0,0,10,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Папки проекта" Style="{StaticResource Subhead}" Margin="3,1,0,7"/>
          <ComboBox x:Name="Projects" AutomationProperties.Name="Текущий проект" ToolTip="Переключить рабочую папку"/>
          <Button x:Name="AddFolder" Content="+  Подключить папку" HorizontalContentAlignment="Left" Margin="0,7,0,7" ToolTip="Выберите папку на компьютере и укажите, что разрешено делать с её файлами"/>
          <Button x:Name="FolderAccess" Content="Доступ к папке" Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Margin="0,0,0,4" ToolTip="Настроить права редактора, локального анализа и обучения"/>
          <Separator Margin="0,4,0,8"/>
          <DockPanel><Button x:Name="Up" Content="↑" DockPanel.Dock="Right" Style="{StaticResource Flat}" Padding="9,2" MinHeight="26" Margin="4,0,0,0" ToolTip="На одну папку выше" AutomationProperties.Name="На одну папку выше"/><TextBlock x:Name="FolderName" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0" TextTrimming="CharacterEllipsis"/></DockPanel>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,5,0,0"><Button x:Name="FileMenu" Content="Файлы…" ToolTip="Создать, скопировать, переместить или переименовать файл"/><Button x:Name="SearchProject" Content="Поиск" ToolTip="Искать текст и формулы по всем DOCX и XLSX в проекте"/></WrapPanel>
        <Grid Margin="0,7,0,0"><ListBox x:Name="Files" AutomationProperties.Name="Файлы текущей папки"><ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding Path}"><Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="{Binding Tint}" Margin="0,0,8,0"><TextBlock Text="{Binding Mark}" Foreground="{Binding Ink}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyFiles" Style="{StaticResource Hint}" Margin="5,8" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" x:Name="Canvas">
      <ScrollViewer x:Name="Landing" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border CornerRadius="22" Padding="26,20" Background="#26322D" Margin="0,0,0,10"><Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="WelcomeTitle" Text="С чего начать?" FontSize="29" Foreground="#FCFCF7" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="WelcomeHint" Text="Подключите папку, чтобы открыть документы и таблицы прямо в OSTUM." FontSize="14" Foreground="#DEE5D9" TextWrapping="Wrap" Margin="0,7,10,0"/></StackPanel>
          <Grid x:Name="DocumentArt" Grid.Column="1" Width="97" Height="79" IsHitTestVisible="False" Margin="12,0,0,0"><Border Width="55" Height="66" CornerRadius="9" Background="#81957F" RenderTransformOrigin="0.5,0.5" Margin="0,0,22,6"><Border.RenderTransform><RotateTransform Angle="-13"/></Border.RenderTransform></Border><Border Width="55" Height="66" CornerRadius="9" Background="#FFE6C9" RenderTransformOrigin="0.5,0.5" Margin="20,7,0,0"><Border.RenderTransform><RotateTransform Angle="9"/></Border.RenderTransform><StackPanel Margin="10,12"><Border Background="#ED8443" Height="8" Width="15" CornerRadius="3" HorizontalAlignment="Left"/><Border Background="#A78D70" Height="3" CornerRadius="1" Margin="0,8,0,4"/><Border Background="#C0A68B" Height="3" CornerRadius="1"/><Border Background="#C0A68B" Height="3" CornerRadius="1" Width="20" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel></Border></Grid>
        </Grid></Border>
        <Border x:Name="DropCard" Style="{StaticResource Card}" BorderBrush="#E8B593" Background="#FFF9F2" Margin="0,0,0,10"><DockPanel>
          <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="13" Background="#FFE4C9" VerticalAlignment="Top" Margin="0,1,13,0"><TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" FontSize="20" Foreground="#8A3F17"/></Border>
          <StackPanel><TextBlock Text="Перетащите сюда папку или файл" Style="{StaticResource Subhead}"/><TextBlock Text="Подойдут папка из Проводника, документ Word (.docx) или таблица Excel (.xlsx). Файлы открываются на своём месте." Style="{StaticResource Hint}" Margin="0,4,0,9"/><WrapPanel><Button x:Name="PickFile" Content="Выбрать файл" Style="{StaticResource Primary}"/><Button x:Name="PickFolder" Content="Выбрать папку" Style="{StaticResource Flat}"/></WrapPanel></StackPanel>
        </DockPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Попробовать на примере" Style="{StaticResource Subhead}"/><TextBlock Text="Откройте учебную заметку. На ней можно исправить текст, проверить правку и сохранить свою версию." Style="{StaticResource Hint}" Margin="0,4,0,8"/><Button x:Name="Sample" Content="Открыть учебный пример" HorizontalAlignment="Left"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Border x:Name="Editor" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed"><DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="1,0,0,5"><DockPanel><Button x:Name="Home" DockPanel.Dock="Right" Content="К началу" Style="{StaticResource Flat}" ToolTip="Закрыть просмотр и выбрать другой файл"/><TextBlock x:Name="DocTitle" Style="{StaticResource Subhead}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
          <TextBlock x:Name="DocHint" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
          <WrapPanel><Button x:Name="Edit" Content="Предложить правку" Style="{StaticResource Primary}"/><Button x:Name="Ask" Content="Спросить Zarum"/><Button x:Name="More" Content="Ещё ▾" ToolTip="Комментарий, формат, сравнение и версии документа"/><ComboBox x:Name="Sheets" MinWidth="95" MaxWidth="170" Margin="0,2" AutomationProperties.Name="Лист Excel"/></WrapPanel>
        </StackPanel>
        <TabControl x:Name="Tabs" Background="White" BorderBrush="#E4E7E0" Padding="4">
          <TabItem Header="Просмотр"><ContentControl x:Name="Page" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem>
          <TabItem x:Name="PatchTab" Header="Правки"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource Hint}" Margin="5,4" Text="Отметьте изменения, которые хотите записать в файл."/><WrapPanel><Button x:Name="Save" Content="Сохранить выбранные" Style="{StaticResource Primary}"/><Button x:Name="Uncheck" Content="Снять отметки"/></WrapPanel></StackPanel><ContentControl x:Name="ChangeHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></DockPanel></TabItem>
          <TabItem Header="Найти в файле"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="3,3,3,7"><Label Target="{Binding ElementName=Filter}" Content="Найти"/><TextBox x:Name="Filter" ToolTip="Введите адрес ячейки, слово, формулу или текст комментария" AutomationProperties.Name="Поиск в документе"/></DockPanel><ContentControl x:Name="RowsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></DockPanel></TabItem>
        </TabControl>
      </DockPanel></Border>
      <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="#F5FFF4E9" BorderBrush="#D56725" BorderThickness="2" CornerRadius="18"><TextBlock Text="Отпустите, чтобы открыть" Style="{StaticResource Title}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="20,7,16,9"><WrapPanel DockPanel.Dock="Right"><Button x:Name="Templates" Content="Шаблоны" Style="{StaticResource Flat}" ToolTip="Создать документы компании и сравнить предложения"/><Button x:Name="Train" Content="Обучение Zarum" Style="{StaticResource Flat}" ToolTip="Обучить модель на проверенных примерах проекта"/></WrapPanel><ContentControl x:Name="Live" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBlock x:Name="Status" Style="{StaticResource Hint}" VerticalAlignment="Center" MaxHeight="54" TextTrimming="CharacterEllipsis"/></DockPanel>
</Grid>
